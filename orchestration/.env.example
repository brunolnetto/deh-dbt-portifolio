# Astro CLI project env (loaded by `astro dev start`).
# Copy to `.env` and set HOST_PROJECT_DIR before starting Airflow.
#
# HOST_PROJECT_DIR must be the ABSOLUTE path to the repo root *on the Docker
# host* (not inside any container). DockerOperator launches sibling containers
# via the mounted docker.sock, so bind-mount sources must resolve on the host,
# e.g. /home/you/github/deh-dbt-portifolio (WSL) or /Users/you/github/deh-dbt-portifolio.
HOST_PROJECT_DIR=/absolute/path/to/deh-dbt-portifolio

DBT_RUNNER_IMAGE=deh-dbt-runner:latest
